# Copy to .env and fill in. .env is gitignored.

ANTHROPIC_API_KEY=sk-ant-...

# Model used by the analyze / reclassify / search-answer stages.
SECOND_BRAIN_MODEL=claude-opus-5

# Browser yt-dlp reads Instagram cookies from (chrome, firefox, safari, edge, brave).
SECOND_BRAIN_COOKIES_BROWSER=chrome

# faster-whisper settings. device: cpu or cuda. compute_type: int8, int8_float16, float16.
SECOND_BRAIN_WHISPER_MODEL=medium
SECOND_BRAIN_WHISPER_DEVICE=cpu
SECOND_BRAIN_WHISPER_COMPUTE_TYPE=int8

# Local multilingual embedding model (Hebrew + English).
SECOND_BRAIN_EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Paths, relative to the repository root unless absolute.
SECOND_BRAIN_DATA_DIR=data
SECOND_BRAIN_EXPORT_DIR=data/instagram_export

# Seconds of random delay between downloads.
SECOND_BRAIN_DOWNLOAD_MIN_DELAY=5
SECOND_BRAIN_DOWNLOAD_MAX_DELAY=15

# Frames extracted per video (4-6).
SECOND_BRAIN_FRAMES_PER_VIDEO=5
